<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.ViewModels"
             xmlns:c="using:Prism.Controls"
             x:Class="Prism.Views.HomeView">
    <UserControl.Styles>
        <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
        <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,9"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
        <Style Selector="Button.tile"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,16"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
        <Style Selector="Button.fileRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,9"/><Setter Property="CornerRadius" Value="8"/></Style>
        <Style Selector="Button.fileRow:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:HomeFile">
            <Button Classes="fileRow" Tag="{Binding Path}" Click="OnOpenFile">
                <ToolTip.Tip><TextBlock Text="{Binding Path}"/></ToolTip.Tip>
                <Grid ColumnDefinitions="Auto,*,Auto,130" ColumnSpacing="14">
                    <c:IconView Icon="box" Width="26" Height="26" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Folder}" Classes="faint" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource PanelAlt}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="{Binding Kind}" Classes="soft" FontSize="11"/></Border>
                    <TextBlock Grid.Column="3" Text="{Binding When}" Classes="soft" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid Background="{DynamicResource AppBg}" ColumnDefinitions="270,*">
        <!-- ============ sidebar ============ -->
        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="20,26">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                    <CheckBox IsChecked="{Binding ShowHomeOnStart}" Content="Show this screen when Prism starts"/>
                    <Button Classes="nav" Click="OnSettings"><TextBlock Text="Settings"/></Button>
                    <Button Classes="nav" Click="OnClose"><TextBlock Text="Back to the model"/></Button>
                </StackPanel>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,0,0,22">
                        <Image Source="/Assets/prism-mark.png" Width="38" Height="38" Stretch="Uniform" AutomationProperties.Name="Prism logo"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Prism" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Solid, surface &amp; freeform CAD" Classes="faint" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Classes="nav" Click="OnNew"><StackPanel Orientation="Horizontal" Spacing="12"><c:IconView Icon="new" Width="22" Height="22"/><TextBlock Text="New part" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Classes="nav" Click="OnOpen"><StackPanel Orientation="Horizontal" Spacing="12"><c:IconView Icon="open" Width="22" Height="22"/><TextBlock Text="Open…" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Classes="nav" Click="OnImportStep"><StackPanel Orientation="Horizontal" Spacing="12"><c:IconView Icon="import" Width="22" Height="22"/><TextBlock Text="Import STEP…" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Classes="nav" Click="OnImportMesh"><StackPanel Orientation="Horizontal" Spacing="12"><c:IconView Icon="mesh-import" Width="22" Height="22"/><TextBlock Text="Import scan or mesh…" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ main ============ -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="52,44,52,40" MaxWidth="940" HorizontalAlignment="Left" Spacing="30">
                <StackPanel Spacing="4">
                    <TextBlock Text="Welcome to Prism" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Pick up where you left off, or start something new." Classes="soft" FontSize="14"/>
                </StackPanel>

                <!-- The examples are remote content; only their catalog ships with Prism. -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Made with Prism" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GalleryStatus}" Classes="soft" TextWrapping="Wrap" MaxWidth="570" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Click="OnGalleryRefresh" IsEnabled="{Binding GalleryAvailable}" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBox Text="{Binding GallerySearch}" Watermark="Find a model or workflow…" Width="340" HorizontalAlignment="Left"/>
                    <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding GalleryBusy}"/>
                    <TextBlock Text="No examples match your search." Classes="faint" IsVisible="{Binding GalleryEmpty}"/>
                    <ItemsControl ItemsSource="{Binding GalleryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GallerySection">
                                <StackPanel Spacing="10" Margin="0,6,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding ToggleText}" Tag="{Binding}" Click="OnGallerySection" IsVisible="{Binding CanExpand}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Visible}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:GalleryCard">
                                        <Border Width="270" Margin="0,0,16,16" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource PanelBg}" ClipToBounds="True">
                                            <StackPanel>
                                                <Panel Height="168" Background="#EDF0F4">
                                                    <c:IconView Icon="box" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Name}"/>
                                                </Panel>
                                                <StackPanel Margin="14" Spacing="7">
                                                    <TextBlock Text="{Binding Workflow}" Classes="soft" FontSize="11"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Height="54" FontSize="12" Classes="soft"/>
                                                    <TextBlock Text="{Binding Credit}" FontSize="11" Classes="faint"/>
                                                    <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="OnGalleryOpen" IsEnabled="{Binding CanOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                                    <TextBlock Text="{Binding VersionHint}" IsVisible="{Binding !Compatible}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- workspace -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel IsVisible="{Binding !HasWorkspace}" Spacing="10">
                            <TextBlock Text="Choose a workspace" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" Classes="soft"
                                       Text="A workspace is the folder your parts live in. Save, Open and new parts all start there, and this screen lists what is inside, so nothing gets lost in Downloads or on the Desktop."/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary" Click="OnUseDefault" Padding="16,9"><TextBlock Name="DefaultLabel" Text="Use Documents\Prism"/></Button>
                                <Button Click="OnChoose" Padding="16,9" Content="Choose another folder…"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid IsVisible="{Binding HasWorkspace}" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="WORKSPACE" Classes="faint" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding WorkspaceFolder}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="New parts are saved here by default." Classes="faint"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnChoose" Content="Change…" Padding="14,7"/>
                                <Button Click="OnExplorer" Content="Show in Explorer" Padding="14,7"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- start -->
                <Grid ColumnDefinitions="*,16,*,16,*" Height="112">
                    <Button Classes="tile" Click="OnNew">
                        <StackPanel Spacing="6"><c:IconView Icon="new" Width="30" Height="30" HorizontalAlignment="Left"/><TextBlock Text="New part" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="A blank model in your workspace" Classes="faint"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="tile" Click="OnOpen">
                        <StackPanel Spacing="6"><c:IconView Icon="open" Width="30" Height="30" HorizontalAlignment="Left"/><TextBlock Text="Open a file" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Prism, STEP, STL, OBJ, 3MF" Classes="faint"/></StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="tile" Click="OnImportMesh">
                        <StackPanel Spacing="6"><c:IconView Icon="mesh-import" Width="30" Height="30" HorizontalAlignment="Left"/><TextBlock Text="Start from a scan" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Import a mesh and rebuild it as CAD" Classes="faint"/></StackPanel>
                    </Button>
                </Grid>

                <!-- parts in the workspace -->
                <StackPanel Spacing="8" IsVisible="{Binding HasWorkspace}">
                    <TextBlock Text="Parts in your workspace" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Nothing saved here yet. Make a part and press Ctrl+S: it lands in this folder." Classes="faint" IsVisible="{Binding !HasWorkspaceFiles}"/>
                    <ItemsControl ItemsSource="{Binding WorkspaceFiles}" IsVisible="{Binding HasWorkspaceFiles}"/>
                </StackPanel>

                <!-- recent -->
                <StackPanel Spacing="8" IsVisible="{Binding HasRecent}">
                    <TextBlock Text="Recent" FontSize="17" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding RecentList}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
