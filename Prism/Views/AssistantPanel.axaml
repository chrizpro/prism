<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.ViewModels" xmlns:ai="using:Prism.Automation"
             x:Class="Prism.Views.AssistantPanel" x:DataType="vm:MainViewModel">
    <Border Width="400" CornerRadius="12" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <!-- header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="16" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="Assistant" FontWeight="SemiBold" FontSize="14"/>
                    <Button Classes="tool" IsVisible="{Binding AssistantNeedsLogin}" Click="OnCodexLogin" Content="Sign in to Codex" ToolTip.Tip="Codex needs a fresh login — this runs 'codex login' in a terminal" Padding="9,4" FontSize="11.5"/>
                    <Button Classes="tool" IsVisible="{Binding AssistantNeedsKeyFix}" Click="OnFixKey" Content="Check the API key" ToolTip.Tip="The provider rejected the key — open the assistant settings to fix it" Padding="9,4" FontSize="11.5"/>
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="{Binding AssistantProviderIndex}" Width="170" FontSize="12" Margin="0,0,6,0">
                    <ComboBoxItem Content="Codex (your login)"/>
                    <ComboBoxItem Content="Claude (API key)"/>
                    <ComboBoxItem Content="OpenAI/Codex (API key)"/>
                </ComboBox>
                <Button Grid.Column="2" Classes="tool" Click="OnSettings" ToolTip.Tip="Settings" Padding="7,4" Content="⚙"/>
                <Button Grid.Column="3" Classes="tool" Click="OnNewChat" ToolTip.Tip="New conversation" Padding="7,4" Content="⟲"/>
            </Grid>
            <!-- settings -->
            <Border Grid.Row="1" IsVisible="{Binding AssistantSettingsOpen}" Background="#1A212B" CornerRadius="8" Padding="10">
                <StackPanel Spacing="7">
                    <TextBlock Text="{Binding AssistantProviderHint}" Classes="soft" TextWrapping="Wrap" FontSize="11.5"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox ItemsSource="{Binding AssistantModels}" SelectedItem="{Binding AssistantModel}" FontSize="12" MaxDropDownHeight="280" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" Classes="tool" Content="↻" Click="OnModelsRefresh" ToolTip.Tip="Refresh the model list" IsEnabled="{Binding !AssistantModelsBusy}" Padding="7,4"/>
                    </Grid>
                    <TextBlock Text="{Binding AssistantModelsStatus}" Classes="faint" FontSize="11" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding AssistantEffortChoices}" SelectedIndex="{Binding AssistantEffortIndex}" FontSize="12" Width="200" HorizontalAlignment="Left" IsVisible="{Binding AssistantHasEfforts}"/>
                    <TextBox Text="{Binding AssistantKey}" Watermark="API key" PasswordChar="•" FontSize="12" IsVisible="{Binding AssistantNeedsKey}"/>
                    <CheckBox Content="Remember the key on this computer (in your user profile)" IsChecked="{Binding AssistantRemember}" IsVisible="{Binding AssistantNeedsKey}" FontSize="11.5"/>
                    <CheckBox Content="Let the assistant open, save and export files" IsChecked="{Binding AssistantAllowFiles}" FontSize="11.5"/>
                </StackPanel>
            </Border>
            <!-- conversation -->
            <Grid Grid.Row="2">
                <TextBlock IsVisible="{Binding AssistantEmpty}" Classes="faint" TextWrapping="Wrap" Margin="6,12" FontSize="12.5"
                           Text="Ask me to model, check or change things. For example: make a 60 x 40 x 8 plate with four 5 mm holes in the corners; what is the volume of the selected body?; or move that hole 10 mm down. I work the same tools you do, so Undo reverses anything I do."/>
                <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChatMessage">
                                <Grid Margin="0,3">
                                    <Border IsVisible="{Binding IsUser}" HorizontalAlignment="Right" Background="#2F7BF0" CornerRadius="10,10,2,10" Padding="10,7" MaxWidth="320">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate DataType="ai:AssistantImage"><Image Source="{Binding Preview}" MaxWidth="140" MaxHeight="100" Margin="0,0,6,4" Stretch="Uniform"/></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                    <Border IsVisible="{Binding IsAssistant}" HorizontalAlignment="Left" Background="#232B38" CornerRadius="10,10,10,2" Padding="10,7" MaxWidth="340">
                                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"/>
                                    </Border>
                                    <TextBlock IsVisible="{Binding IsTool}" Text="{Binding Text}" Classes="faint" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextTrimming="CharacterEllipsis" Margin="6,0"/>
                                    <TextBlock IsVisible="{Binding IsNote}" Text="{Binding Text}" Classes="faint" TextWrapping="Wrap" FontSize="11.5" Margin="6,0"/>
                                    <Border IsVisible="{Binding IsError}" Background="#3A1F24" BorderBrush="#7A3039" BorderThickness="1" CornerRadius="8" Padding="9,6">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFB3B8" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <!-- input -->
            <StackPanel Grid.Row="3" Spacing="6">
                <ItemsControl ItemsSource="{Binding AssistantAttachments}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="ai:AssistantImage">
                            <Border Background="#232B38" CornerRadius="6" Padding="4" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Image Source="{Binding Preview}" MaxWidth="48" MaxHeight="36" Stretch="Uniform"/>
                                    <Button Classes="tool" Content="✕" Click="OnRemoveAttachment" Tag="{Binding}" Padding="4,0" FontSize="10" ToolTip.Tip="Remove"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Button Classes="tool" Content="📎" Click="OnAttach" ToolTip.Tip="Attach an image file, or the current 3D view (Ctrl+V pastes a picture too)" Padding="9,7"/>
                    <TextBox Grid.Column="1" Name="Input" Text="{Binding AssistantInput}" Watermark="Ask the assistant…" AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="90" FontSize="12.5" KeyDown="OnInputKey" IsEnabled="{Binding !AssistantBusy}"/>
                    <Button Grid.Column="2" Content="Send" Click="OnSend" Padding="14,7" IsVisible="{Binding !AssistantBusy}"/>
                    <Button Grid.Column="2" Content="Stop" Click="OnStop" Padding="14,7" IsVisible="{Binding AssistantBusy}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
