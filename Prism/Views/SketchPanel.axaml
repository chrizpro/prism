<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.ViewModels"
             xmlns:views="using:Prism.Views"
             xmlns:c="using:Prism.Controls"
             x:Class="Prism.Views.SketchPanel">
    <UserControl.Styles><StyleInclude Source="avares://Prism/Styles/Studio.axaml"/></UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SketchToolSection">
            <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                <Expander.Header><c:PanelStepHeader Step="{Binding Number}" Title="{Binding Title}" Margin="-10,-8"/></Expander.Header>
                <StackPanel Margin="12,0" Spacing="9">
                    <TextBlock Text="{Binding Guidance}" IsVisible="{Binding HasGuidance}" Classes="soft" TextWrapping="Wrap" FontSize="12"/>
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate DataType="vm:ToolOptionItem">
                            <Button Classes="studioAction" Classes.primary="{Binding IsSelected}" Click="OnToolOption" Margin="0,0,5,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Label}">
                                <Grid ColumnDefinitions="20,*" ColumnSpacing="6"><c:IconView Icon="{Binding Icon}" Width="18" Height="18"/><TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Controls}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </DataTemplate>
        <DataTemplate DataType="vm:ToolControlRow">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsInfo}"/>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding On, Mode=TwoWay}" IsVisible="{Binding IsToggle}" IsEnabled="{Binding Enabled}"/>
                <Grid ColumnDefinitions="*,104,28" ColumnSpacing="7" IsVisible="{Binding IsNumber}" IsEnabled="{Binding Enabled}">
                    <TextBlock Text="{Binding Label}" Classes="soft" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBox Grid.Column="1" Text="{Binding NumberText, Mode=TwoWay}" HorizontalContentAlignment="Right" GotFocus="OnToolNumberFocus" KeyDown="OnToolNumberKey" LostFocus="OnToolNumberLost" AutomationProperties.Name="{Binding Label}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Classes="soft" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="11"/>
                <Button Content="{Binding Label}" Classes="studioAction" Classes.primary="{Binding Primary}" IsEnabled="{Binding CanRun}" IsVisible="{Binding IsButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnToolButton"/>
                <TextBlock Text="{Binding Text}" Classes="soft" TextWrapping="Wrap" IsVisible="{Binding HasText}" FontSize="11"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>
    <DockPanel Background="{DynamicResource PanelBg}">
        <Border DockPanel.Dock="Top" Padding="12,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding ToolPanelTitle}" FontSize="14" FontWeight="SemiBold"/></Border>
        <Border DockPanel.Dock="Bottom" Padding="14,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBg}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Button Grid.Column="1" Classes="ghost" Content="Cancel" Click="OnCancel"/>
                <Button Grid.Column="2" Classes="primary" Content="Finish sketch" Click="OnFinish"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <!-- Every sketch-tool family uses the same ordered, collapsible presentation. -->
        <ItemsControl ItemsSource="{Binding ToolSections}" Margin="0,0,0,4"/>

        <views:SketchSpacePanel/>

        <StackPanel DockPanel.Dock="Top" Margin="14,14,14,6" Spacing="4">
            <TextBlock Text="Sketch status" Classes="section"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Ok}" VerticalAlignment="Center" IsVisible="{Binding SketchFull}"/>
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}" VerticalAlignment="Center" IsVisible="{Binding SketchFree}"/>
                <Ellipse Width="10" Height="10" Fill="{DynamicResource Danger}" VerticalAlignment="Center" IsVisible="{Binding SketchBad}"/>
                <TextBlock Text="{Binding SketchStateText}" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding SketchSummary}" Classes="faint" TextWrapping="Wrap"/>
            <TextBlock Text="Blue geometry can still move; white is fully constrained. Drag with Select to test it." Classes="faint" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="Constraints and dimensions" Classes="panelTitle" Margin="0,14,0,4"/>
        </StackPanel>

        <Panel>
            <ListBox ItemsSource="{Binding SketchConstraints}" Classes="hist" DoubleTapped="OnRowDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ConstraintRow">
                        <Grid ColumnDefinitions="26,*,Auto,Auto" Height="40" ColumnSpacing="8" Background="Transparent" Margin="{Binding Indent}">
                            <TextBlock Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsDetail}"/>
                            <Button Classes="tool" Content="{Binding Glyph}" Tag="{Binding GroupName}" Click="OnToggleGroup" IsVisible="{Binding IsHeader}" FontSize="13" Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Classes="faint" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" IsVisible="{Binding HasValue}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Classes="tool" Content="✕" FontSize="10" Padding="6,3" Click="OnDeleteRow" ToolTip.Tip="Remove" IsVisible="{Binding IsDetail}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No constraints yet. Draw lines near horizontal or vertical, snap to points, or use the Constrain and Dimension tools." Classes="faint" TextWrapping="Wrap"
                       Margin="18,6" IsHitTestVisible="False" VerticalAlignment="Top"
                       IsVisible="{Binding !SketchConstraints.Count}"/>
        </Panel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
