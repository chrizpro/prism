<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Prism.Views.SettingsWindow"
        Title="Settings" Width="940" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBg}">
    <Grid ColumnDefinitions="190,1,*">
        <Border Background="{DynamicResource TabBarBg}" Padding="10,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,12"/>
                <TextBox Name="Search" Watermark="Search settings" FontSize="12" Margin="0,0,0,6" TextChanged="OnSearch" KeyDown="OnSearchKey"/>
                <ListBox Name="SearchResults" Background="Transparent" IsVisible="False" MaxHeight="300" SelectionChanged="OnSearchPick"/>
                <ListBox Name="Nav" Background="Transparent" SelectedIndex="0" SelectionChanged="OnNav">
                    <ListBoxItem Content="Appearance"/>
                    <ListBoxItem Content="Interaction"/>
                    <ListBoxItem Content="Workspace"/>
                    <ListBoxItem Content="Toolbars"/>
                    <ListBoxItem Content="Ribbon"/>
                    <ListBoxItem Content="AI Assistant"/>
                    <ListBoxItem Content="Keyboard"/>
                </ListBox>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Line}"/>

        <Panel Grid.Column="2">
            <!-- ============ appearance ============ -->
            <ScrollViewer Name="PageAppearance">
                <StackPanel Margin="28,24" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="Dark is easier on the eyes in a dim room; Light suits a bright office or printing screenshots." Classes="soft" TextWrapping="Wrap"/>
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <RadioButton Name="ThemeDark" GroupName="theme" Content="Dark" Click="OnTheme"/>
                        <RadioButton Name="ThemeLight" GroupName="theme" Content="Light" Click="OnTheme"/>
                        <RadioButton Name="ThemeSystem" GroupName="theme" Content="Match Windows" Click="OnTheme"/>
                    </StackPanel>
                    <TextBlock Text="Interface color" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Text="Choose the accent used for buttons and selections. The 3D grid has its own setting below." Classes="soft" TextWrapping="Wrap"/>
                    <ComboBox Name="AccentChoice" Width="200" HorizontalAlignment="Left" SelectionChanged="OnAccent">
                        <ComboBoxItem Content="Blue"/><ComboBoxItem Content="Teal"/><ComboBoxItem Content="Purple"/><ComboBoxItem Content="Orange"/><ComboBoxItem Content="Rose"/>
                    </ComboBox>
                    <TextBlock Text="3D view backdrop and grid" FontWeight="SemiBold" Margin="0,22,0,0"/>
                    <CheckBox Name="ShowGridOnStart" Content="Show the grid when Prism starts" Click="OnShowGridOnStart"/>
                    <TextBlock Text="Pick a look for the space you model in. Classic follows the theme above; the rest keep their own colors." Classes="soft" TextWrapping="Wrap"/>
                    <WrapPanel Name="GridHost" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ interaction ============ -->
            <ScrollViewer Name="PageInteraction" IsVisible="False">
                <StackPanel Margin="28,24" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Interaction" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Help context location" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ComboBox Name="HelpContextLocation" Width="240" HorizontalAlignment="Left" SelectionChanged="OnHelpContextLocation">
                        <ComboBoxItem Content="Viewport (top right)"/><ComboBoxItem Content="Bottom status bar"/>
                    </ComboBox>
                    <TextBlock Text="Navigation" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <CheckBox Name="ReverseScrollZoom" Content="Reverse scroll-wheel zoom" Click="OnReverseScrollZoom"/>
                    <TextBlock Text="Reverse the direction the mouse wheel zooms in the 3D view." Classes="soft" TextWrapping="Wrap"/>
                    <TextBlock Text="Right-click menu" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="Hold the right mouse button still and a ring of tools for what you are looking at appears: drag toward one and let go. A quick right click opens the same ring. Moving first orbits as usual." Classes="soft" TextWrapping="Wrap"/>
                    <CheckBox Name="MarkingOn" Content="Use the right-click menu" Click="OnMarking"/>
                    <StackPanel Spacing="4" Margin="0,6,0,0">
                        <TextBlock Name="HoldLabel" Text="Hold time"/>
                        <Slider Name="HoldMs" Minimum="100" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left" ValueChanged="OnHold"/>
                        <TextBlock Text="How long to keep the button still before the ring opens. Shorter feels snappier; longer avoids it popping up when you only meant to orbit." Classes="faint" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Reference plane size" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <StackPanel Spacing="4">
                        <TextBlock Name="PlaneScaleLabel" Text="Plane size: 100 %"/>
                        <Slider Name="PlaneScale" Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left" ValueChanged="OnPlaneScale"/>
                        <TextBlock Text="How big the origin and construction planes draw in the 3D view — including the ones Create Sketch and other picks reveal. Smaller keeps a crowded scene clear; bigger is easier to click." Classes="faint" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ workspace ============ -->
            <ScrollViewer Name="PageWorkspace" IsVisible="False">
                <StackPanel Margin="28,24" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Workspace" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Your workspace is the folder your parts live in. Save, Open and new-part names all start there, and the home screen lists what is inside." Classes="soft" TextWrapping="Wrap"/>
                    <TextBlock Name="WsPath" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <WrapPanel>
                        <Button Content="Change…" Click="OnWsChange" Margin="0,0,8,6"/>
                        <Button Name="WsDefault" Content="Use the default (Documents\Prism)" Click="OnWsDefault" Margin="0,0,8,6"/>
                        <Button Content="Show in Explorer" Click="OnWsShow" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <CheckBox Name="WsHome" Content="Show the home screen when Prism starts" Click="OnWsHome" Margin="0,8,0,0"/>
                    <CheckBox Name="StartupUpdates" Content="Check for updates at startup" Click="OnStartupUpdates"/>
                    <TextBlock Text="Autosave and recovery" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <CheckBox Name="RecoveryEnabled" Content="Autosave separate recovery copies" Click="OnRecoveryEnabled"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Save a recovery copy every" VerticalAlignment="Center"/>
                        <NumericUpDown Name="RecoveryInterval" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="95" ValueChanged="OnRecoveryInterval"/>
                        <TextBlock Text="minutes" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Includes untitled documents. Original files stay untouched; unfinished edits wait until you finish or cancel them." Classes="soft" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RecoveryStatus}" Classes="soft" TextWrapping="Wrap"/>
                    <Button Content="Recover autosaved work…" Click="OnRecoverWork" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ toolbars ============ -->
            <ScrollViewer Name="PageToolbars" IsVisible="False">
                <StackPanel Margin="28,24" Spacing="14">
                    <TextBlock Text="Toolbars" FontSize="20" FontWeight="SemiBold"/>
                    <StackPanel Name="ToolbarHost" Spacing="26"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Name="PageAssistant" IsVisible="False">
                <StackPanel Margin="28,24" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="AI Assistant" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Provider" FontWeight="SemiBold"/>
                    <ComboBox Name="AiProvider" SelectedIndex="{Binding AssistantProviderIndex}" Width="250" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Codex (your login)"/><ComboBoxItem Content="Claude (API key)"/><ComboBoxItem Content="OpenAI/Codex (API key)"/>
                    </ComboBox>
                    <TextBlock Text="{Binding AssistantProviderHint}" Classes="soft" TextWrapping="Wrap"/>
                    <TextBlock Text="Model" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox Name="AiModel" ItemsSource="{Binding AssistantModels}" SelectedItem="{Binding AssistantModel}" Width="320" MaxDropDownHeight="300"/>
                        <Button Name="AiModelsRefresh" Classes="tool" Content="↻" Click="OnAiRefresh" ToolTip.Tip="Refresh the model list" Padding="7,4" IsEnabled="{Binding !AssistantModelsBusy}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AssistantModelsStatus}" Classes="faint" TextWrapping="Wrap"/>
                    <TextBlock Text="Effort" FontWeight="SemiBold" IsVisible="{Binding AssistantHasEfforts}"/>
                    <ComboBox Name="AiEffort" ItemsSource="{Binding AssistantEffortChoices}" SelectedIndex="{Binding AssistantEffortIndex}" Width="250" HorizontalAlignment="Left" IsVisible="{Binding AssistantHasEfforts}"/>
                    <TextBox Name="AiKey" Text="{Binding AssistantKey}" Watermark="API key" PasswordChar="•" Width="320" HorizontalAlignment="Left" IsVisible="{Binding AssistantNeedsKey}"/>
                    <CheckBox Name="AiRemember" Content="Remember the key on this computer (in your user profile)" IsChecked="{Binding AssistantRemember}" IsVisible="{Binding AssistantNeedsKey}"/>
                    <CheckBox Name="AiFiles" Content="Let the assistant open, save and export files" IsChecked="{Binding AssistantAllowFiles}"/>
                    <Separator Margin="0,6"/>
                    <TextBlock Text="MCP — use Prism from an external agent" FontWeight="SemiBold"/>
                    <TextBlock Text="Prism runs a local automation server while it is open. Point your agent's client at the Prism.Mcp bridge: Set up writes it into the client's config file for you (the old file is kept as .bak), or Copy the block and paste it yourself. The client can then drive modeling, inspection, screenshots, settings and the script editor." Classes="soft" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Set up Claude Desktop" Tag="claude" Click="OnInstallMcp"/>
                        <Button Content="Set up Codex" Tag="codex" Click="OnInstallMcp"/>
                        <Button Content="Copy for Claude" Tag="claude" Click="OnCopyMcp"/>
                        <Button Content="Copy for Codex" Tag="codex" Click="OnCopyMcp"/>
                    </StackPanel>
                    <TextBlock Name="McpNote" Classes="faint" TextWrapping="Wrap"/>
                    <TextBox Name="McpConfig" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" MaxHeight="150"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ ribbon ============ -->
            <Grid Name="PageRibbon" IsVisible="False" RowDefinitions="Auto,*" Margin="28,24,28,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Ribbon" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Make the ribbon yours: hide tabs you never use, move commands between groups, and build whole new tabs. Everything can be put back the way it shipped." Classes="soft" TextWrapping="Wrap"/>
                    <StackPanel Name="RibbonBar" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"/>
                    <StackPanel Name="RibbonBar2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Text="In this tab" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ListBox Name="Rows" Grid.Row="1" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6"/>
                        <WrapPanel Name="RowButtons" Grid.Row="2" Margin="0,8,0,0"/>
                    </Grid>
                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Text="All commands" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Name="Filter" Grid.Row="1" Watermark="Search commands" Margin="0,0,0,6" TextChanged="OnFilter"/>
                        <ListBox Name="Catalog" Grid.Row="2" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" DoubleTapped="OnCatalogDouble"/>
                        <WrapPanel Name="CatButtons" Grid.Row="3" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
            <!-- ============ keyboard ============ -->
            <ScrollViewer Name="PageKeyboard" IsVisible="False">
                <StackPanel Name="KeyboardHost" Margin="28,24" Spacing="6" MaxWidth="940" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Panel>
    </Grid>
</Window>
