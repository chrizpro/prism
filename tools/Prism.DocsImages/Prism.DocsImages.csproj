<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NativeLibraryDirectory Condition="'$(NativeLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\native\bin</NativeLibraryDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Prism/Prism.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.6" />
    <None Include="$(NativeLibraryDirectory)\*.dll;$(NativeLibraryDirectory)\*.so*;$(NativeLibraryDirectory)\*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
