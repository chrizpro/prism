---
import Base from '../layouts/Base.astro'
import { docs, repoUrl, version } from '../config'

const platforms = [
  { name: 'Windows', detail: 'Windows 10 and 11, x64', pkg: 'Setup .exe', status: 'Preview builds available', ready: true },
  { name: 'macOS', detail: 'Apple Silicon and Intel', pkg: '.app in .dmg', status: 'Packaging in preparation', ready: false },
  { name: 'Linux', detail: 'x64', pkg: '.deb', status: 'Packaging in preparation', ready: false },
]
---
<Base title="Download" description="Download Prism for Windows. macOS and Linux packages are in preparation.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Download</span>
        <h1>Get Prism</h1>
        <p>Prism is a {version}. A public release has not been published yet; preview installers are prepared from the repository for testers.</p>
      </div>

      <div class="platforms">
        {platforms.map(p => (
          <div class:list={['platform', { ready: p.ready }]}>
            <h2>{p.name}</h2>
            <p class="muted">{p.detail}</p>
            <span class="pkg">{p.pkg}</span>
            <span class="status">{p.status}</span>
          </div>
        ))}
      </div>

      <div class="notes">
        <div>
          <h3>What's in the installer</h3>
          <p class="muted">A self-contained desktop app with the .NET runtime, the native geometry and simulation libraries, the MCP automation bridge and the Python <code>cadkit</code> library. It installs per user, adds a Start menu shortcut and includes an uninstaller that leaves your documents and preferences in place.</p>
        </div>
        <div>
          <h3>Optional extras</h3>
          <p class="muted">Thermal and modal studies use an external CalculiX installation. Rendering animations to MP4 uses ffmpeg. Scripts need Python 3.</p>
        </div>
        <div>
          <h3>Build from source</h3>
          <p class="muted">Clone the <a href={repoUrl}>repository on GitHub</a>, install the .NET 10 SDK and the native toolchain, build the native libraries, then run the desktop project. The <a href={docs('/development')}>build guide</a> has every step.</p>
        </div>
      </div>

      <div class="cta">
        <a class="btn btn-primary" href={docs('/download')}>Installation guide</a>
        <a class="btn btn-ghost" href={docs('/guide/getting-started')}>Getting started</a>
        <a class="btn btn-ghost" href={docs('/changelog')}>Release notes</a>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); margin: 12px 0 16px; }
  .platforms { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .platform { padding: 28px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); display: grid; gap: 8px; }
  .platform.ready { border-color: rgba(57, 200, 237, 0.5); background: radial-gradient(80% 100% at 0% 0%, rgba(57, 200, 237, 0.15), transparent 70%), var(--panel); }
  .platform h2 { font-size: 1.6rem; }
  .pkg { font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; margin-top: 8px; }
  .status { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .ready .status { color: var(--cyan); }
  .notes { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px; margin: 56px 0 40px; }
  .notes h3 { font-size: 1.15rem; margin-bottom: 10px; }
  .notes a { color: var(--cyan); }
  code { font-size: 0.9em; color: var(--ice); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
