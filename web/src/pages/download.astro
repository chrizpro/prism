---
import Base from '../layouts/Base.astro'
import { docs, repoUrl, version } from '../config'
import { latestRelease } from '../data/release'

const { release, downloads } = await latestRelease()
const available = downloads.filter(d => d.url)
const mb = (bytes?: number) => bytes ? `${(bytes / 1048576).toFixed(0)} MB` : ''
const date = release ? new Date(release.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : ''
---
<Base title="Download" description="Download Prism for Windows, macOS and Linux.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Download</span>
        <h1>Get Prism</h1>
        {release
          ? <p>{release.name}{release.prerelease ? ' (alpha)' : ''}, released {date}. Free to download for Windows, macOS and Linux.</p>
          : <p>Prism is at version {version}. The first downloadable release has not been published yet. Until it is, you can build Prism from source.</p>}
      </div>

      <div class="notice" role="note">
        <strong>This is alpha software.</strong> Prism is under active development: features and workflows may change between releases, and you may run into bugs. Don't rely on it for production work yet, and keep backups of your models. Check the <a href={docs('/reference/known-issues')}>known issues</a> before you start, and <a href={`${repoUrl}/issues/new?template=bug_report.yml`}>report bugs</a> when you find them.
      </div>

      {available.length > 0 && (
        <div class="primary" id="recommended" hidden>
          <a class="btn btn-primary big" id="recommended-link" href="#">Download</a>
          <p class="muted" id="recommended-detail"></p>
        </div>
      )}

      <div class="platforms">
        {downloads.map(d => (
          <div class:list={['platform', { ready: d.url }]} data-id={d.id} data-os={d.os}>
            <h2>{d.label}</h2>
            <p class="muted">{d.detail}</p>
            {d.url
              ? <>
                  <a class="btn btn-primary" href={d.url}>Download {mb(d.size) && <span class="size">{mb(d.size)}</span>}</a>
                  {d.sha256Url && <a class="sha" href={d.sha256Url}>SHA-256 checksum</a>}
                </>
              : <span class="status">{release ? 'Not in this release' : 'Coming with the first release'}</span>}
          </div>
        ))}
      </div>

      <div class="notes">
        <div>
          <h3>Installing</h3>
          <p class="muted"><strong>Windows:</strong> run the setup program. It installs for your user only and includes an uninstaller. Alpha builds are not code-signed yet, so Windows may show a SmartScreen warning: choose <em>More info › Run anyway</em>.</p>
          <p class="muted"><strong>macOS:</strong> open the .dmg and drag Prism to Applications. Alpha builds are not notarized yet, so the first time, right-click Prism and choose <em>Open</em>.</p>
          <p class="muted"><strong>Linux:</strong> <code>sudo apt install ./Prism-linux-x64.deb</code></p>
        </div>
        <div>
          <h3>What's included</h3>
          <p class="muted">A self-contained desktop app with the .NET runtime, the geometry and simulation libraries, the MCP automation bridge and the Python <code>cadkit</code> library. Your documents and preferences stay in place when you uninstall.</p>
          <p class="muted">Optional: thermal and modal studies use CalculiX, MP4 output uses ffmpeg, and scripts need Python 3.</p>
        </div>
        <div>
          <h3>Build from source</h3>
          <p class="muted">Fork or clone the <a href={repoUrl}>repository on GitHub</a>, install the .NET 10 SDK and the native toolchain, build the native libraries, then run the desktop project. The <a href={`${repoUrl}#run-prism-from-a-fork`}>README</a> and the <a href={docs('/development')}>build guide</a> have every step.</p>
        </div>
      </div>

      <div class="cta">
        <a class="btn btn-ghost" href={`${repoUrl}/releases`}>All releases</a>
        <a class="btn btn-ghost" href={docs('/guide/getting-started')}>Getting started</a>
        <a class="btn btn-ghost" href={docs('/changelog')}>Release notes</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Put the download for this computer first. Macs cannot reliably report their chip, so both Mac builds stay listed.
  const ua = navigator.userAgent
  const os = /Windows/.test(ua) ? 'windows' : /Mac/.test(ua) ? 'macos-arm64' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : ''
  const card = os && document.querySelector<HTMLElement>(`.platform[data-id="${os}"]`)
  const link = card?.querySelector<HTMLAnchorElement>('a.btn')
  const box = document.getElementById('recommended')
  if (card && link && box) {
    const anchor = document.getElementById('recommended-link') as HTMLAnchorElement
    anchor.href = link.href
    anchor.textContent = `Download for ${card.dataset.os}`
    document.getElementById('recommended-detail')!.textContent = os === 'macos-arm64' ? 'Apple silicon build. Intel Mac? Use the Intel download below.' : card.querySelector('p')?.textContent ?? ''
    box.hidden = false
    card.classList.add('mine')
  }
</script>

<style>
  h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); margin: 12px 0 16px; }
  .notice { margin: -16px 0 36px; padding: 16px 20px; border-radius: var(--radius); border: 1px solid rgba(245, 184, 61, 0.35); background: rgba(245, 184, 61, 0.08); color: #f3dfb0; max-width: 820px; }
  .notice a { color: #ffd77a; }
  .primary { margin: 0 0 40px; display: grid; gap: 10px; justify-items: start; }
  .primary[hidden] { display: none; }
  .big { font-size: 1.1rem; padding: 1rem 1.8rem; }
  .platforms { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .platform { padding: 26px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); display: grid; gap: 10px; align-content: start; }
  .platform.ready { border-color: rgba(57, 200, 237, 0.35); }
  .platform.mine { border-color: var(--cyan); background: radial-gradient(80% 100% at 0% 0%, rgba(57, 200, 237, 0.15), transparent 70%), var(--panel); }
  .platform h2 { font-size: 1.35rem; }
  .platform .btn { justify-self: start; margin-top: 6px; }
  .size { opacity: 0.75; font-weight: 500; font-size: 0.85em; }
  .sha { font-size: 0.8rem; color: var(--muted); }
  .status { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .notes { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px; margin: 56px 0 40px; }
  .notes h3 { font-size: 1.15rem; margin-bottom: 10px; }
  .notes p + p { margin-top: 10px; }
  .notes a { color: var(--cyan); }
  code { font-size: 0.85em; color: var(--ice); word-break: break-word; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
