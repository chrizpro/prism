<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.ViewModels"
             xmlns:c="using:Prism.Controls"
             x:Class="Prism.Views.PropertiesPanel">
    <UserControl.Styles><StyleInclude Source="avares://Prism/Styles/Studio.axaml"/></UserControl.Styles>
    <DockPanel Background="{DynamicResource PanelBg}">
        <Border DockPanel.Dock="Top" Padding="12,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TextBlock Text="Properties" FontSize="14" FontWeight="SemiBold"/></Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,14,14,10" Spacing="4">

            <StackPanel IsVisible="{Binding !HasSelection}" Spacing="6" Margin="0,24,0,0">
                <TextBlock Text="Nothing selected" FontWeight="SemiBold" HorizontalAlignment="Center" Classes="soft"/>
                <TextBlock Text="Click an object in the viewport or in the Model list to see its properties." TextWrapping="Wrap" TextAlignment="Center" Classes="faint"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasSelection}" Spacing="4">
                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="12,8" Margin="-14,-14,-14,10"><TextBlock Text="Selection" FontWeight="SemiBold"/></Border>
                <TextBlock Text="{Binding SelectionTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Object name" Classes="meta" Margin="0,6,0,0"/>
                <TextBox Name="RenameBox" Text="{Binding RenameText}" Watermark="Name" Padding="8,6" CornerRadius="4" KeyDown="OnRenameKey" LostFocus="OnRenameLostFocus"/>
                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="12,8" Margin="-14,12,-14,6"><TextBlock Text="Properties" FontWeight="SemiBold"/></Border>
                <ItemsControl ItemsSource="{Binding Properties}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyLine">
                            <Grid ColumnDefinitions="110,*" Margin="0,3">
                                <TextBlock Text="{Binding Label}" Classes="soft"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="12,8" Margin="-14,12,-14,10"><TextBlock Text="Display color" FontWeight="SemiBold"/></Border>
                <ItemsControl Name="Swatches">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Name="OpenTimelineButton" IsVisible="{Binding IsAnimationSelected}" Content="Open animation timeline" Click="OnOpenTimeline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7" Margin="0,8,0,0"/>
            </StackPanel>

            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="12,8" Margin="-14,16,-14,6"><TextBlock Text="Part info" FontWeight="SemiBold"/></Border>
            <TextBlock Text="Saved inside this file. The parts library, drawings and assembly parts lists use it." Classes="faint" TextWrapping="Wrap"/>
            <Border IsVisible="{Binding HasPartThumb}" Width="112" Height="112" HorizontalAlignment="Left" CornerRadius="6" ClipToBounds="True" Margin="0,6,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="1" ToolTip.Tip="A picture of the part, saved with it and refreshed every time you save. The parts library shows it.">
                <Image Source="{Binding PartThumb}" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="Part number" Classes="meta" Margin="0,6,0,0"/>
            <TextBox Name="PartNumberBox" Text="{Binding PartNumber}" Padding="8,6" CornerRadius="4"/>
            <TextBlock Text="Description" Classes="meta" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PartDescription}" Padding="8,6" CornerRadius="4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"/>
            <Grid ColumnDefinitions="*,8,*" Margin="0,6,0,0">
                <StackPanel><TextBlock Text="Revision" Classes="meta"/><TextBox Text="{Binding PartRevision}" Padding="8,6" CornerRadius="4"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Cost each" Classes="meta"/><TextBox Text="{Binding PartCost}" Padding="8,6" CornerRadius="4"/></StackPanel>
            </Grid>
            <TextBlock Text="Material" Classes="meta" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PartMaterial}" Padding="8,6" CornerRadius="4"/>
            <TextBlock Text="Supplier" Classes="meta" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PartSupplier}" Padding="8,6" CornerRadius="4"/>
            <TextBlock Text="Tags (separate with commas)" Classes="meta" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PartTags}" Padding="8,6" CornerRadius="4"/>
            <TextBlock Text="Other fields (one per line, name: value)" Classes="meta" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PartCustom}" Padding="8,6" CornerRadius="4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"/>

        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
