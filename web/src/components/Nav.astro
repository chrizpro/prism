---
import mark from '../assets/prism-mark.svg?raw'
import { docs, href, repoUrl } from '../config'

const path = Astro.url.pathname
const links = [
  { text: 'Features', url: href('/features'), match: '/features' },
  { text: 'Download', url: href('/download'), match: '/download' },
  { text: 'Docs', url: docs('/'), external: true },
  { text: 'API', url: docs('/api/'), external: true },
  { text: 'GitHub', url: repoUrl, external: true },
]
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={href('/')} aria-label="Prism home">
      <span class="mark" set:html={mark} />
      <span>Prism</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav aria-label="Main">
      {links.map(l => (
        <a href={l.url} class:list={{ active: l.match && path.includes(l.match) }} {...(l.external ? { rel: 'noopener' } : {})}>{l.text}</a>
      ))}
      <a class="btn btn-primary nav-cta" href={href('/download')}>Get Prism</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(1.4);
    background: rgba(9, 15, 26, 0.72);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 1.25rem; }
  .mark { width: 30px; height: 30px; display: block; }
  .mark :global(svg) { width: 100%; height: 100%; }
  nav { display: flex; align-items: center; gap: 28px; }
  nav a:not(.btn) { text-decoration: none; color: var(--muted); font-weight: 500; font-size: 0.95rem; }
  nav a:not(.btn):hover, nav a.active { color: var(--text); }
  .nav-cta { padding: 0.5rem 1.1rem; font-size: 0.9rem; }
  .nav-toggle, .nav-burger { display: none; }

  @media (max-width: 760px) {
    .nav-burger { display: grid; place-items: center; width: 40px; height: 40px; cursor: pointer; }
    .nav-burger span, .nav-burger span::before, .nav-burger span::after {
      content: ''; display: block; width: 22px; height: 2px; background: var(--text); border-radius: 2px; position: relative;
    }
    .nav-burger span::before { position: absolute; top: -7px; }
    .nav-burger span::after { position: absolute; top: 7px; }
    nav {
      position: absolute; top: 64px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--bg-2); border-bottom: 1px solid var(--line);
      padding: 8px 16px 16px; display: none;
    }
    nav a:not(.btn) { padding: 12px 0; border-bottom: 1px solid var(--line); }
    .nav-cta { margin-top: 12px; justify-content: center; }
    .nav-toggle:checked ~ nav { display: flex; }
  }
</style>
