<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Prism.Controls" x:Class="Prism.Views.GizmoOptionsPanel" Background="{DynamicResource PanelBg}">
    <UserControl.Styles><StyleInclude Source="avares://Prism/Styles/Studio.axaml"/></UserControl.Styles>
    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Name="GizmoPanelScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Expander Name="GizmoOptionsExpander" Header="Edit Gizmo" IsExpanded="True" HorizontalAlignment="Stretch">
        <StackPanel Spacing="9" Margin="12,0">
            <TextBlock Text="{Binding GizmoBindingStatus}" Classes="soft" TextWrapping="Wrap"/>
            <StackPanel IsEnabled="{Binding CanPlaceGizmo}" Spacing="8">
                <TextBlock Text="Operation" Classes="section"/>
                <ComboBox ItemsSource="{Binding GizmoOperations}" SelectedIndex="{Binding GizmoActiveOperation, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <Button Classes="studioAction" Content="Unbind: move the gizmo without moving geometry" IsVisible="{Binding !GizmoPositioning}" Click="OnPlace" HorizontalAlignment="Stretch"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="Location (mm)" Classes="section"/>
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <TextBlock Text="X" Classes="meta"/><TextBlock Grid.Column="1" Text="Y" Classes="meta"/><TextBlock Grid.Column="2" Text="Z" Classes="meta"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding GizmoOriginX, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo X"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GizmoOriginY, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo Y"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding GizmoOriginZ, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo Z"/>
                    </Grid>
                    <TextBlock Text="Rotation (degrees)" Classes="section"/>
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <TextBlock Text="X" Classes="meta"/><TextBlock Grid.Column="1" Text="Y" Classes="meta"/><TextBlock Grid.Column="2" Text="Z" Classes="meta"/>
                        <NumericUpDown Grid.Row="1" Value="{Binding GizmoRotationX, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo rotation X"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GizmoRotationY, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo rotation Y"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding GizmoRotationZ, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo rotation Z"/>
                    </Grid>
                    <StackPanel IsVisible="{Binding HasGizmoPlanes}" Spacing="8">
                        <TextBlock Text="{Binding GizmoScaleHeader}" Classes="section"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                            <TextBlock Text="X" Classes="meta"/><TextBlock Grid.Column="1" Text="Y" Classes="meta"/><TextBlock Grid.Column="2" Text="{Binding GizmoScaleZLabel}" Classes="meta"/>
                            <NumericUpDown Grid.Row="1" Value="{Binding GizmoScaleX, Mode=TwoWay}" Minimum="0.01" Maximum="8" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo scale X"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GizmoScaleY, Mode=TwoWay}" Minimum="0.01" Maximum="8" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo scale Y"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding GizmoScaleZ, Mode=TwoWay}" IsEnabled="{Binding GizmoScaleZEnabled}" Minimum="0.01" Maximum="8" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="Gizmo scale Z"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding GizmoIsNotDatum}" Spacing="8">
                <Button Content="Reset pivot to selection" Classes="studioAction" Click="OnResetPivot" HorizontalAlignment="Stretch"/></StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasGizmoPlanes}" Spacing="8">
                <TextBlock Text="Drawing in 3D" Classes="section" Margin="0,6,0,0"/>
                <CheckBox Content="Gizmo follows last point" IsChecked="{Binding SketchGizmoFollows, Mode=TwoWay}" ToolTip.Tip="Move the gizmo to each placed point without moving existing curves."/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="Gizmo plane" Classes="soft" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" IsEnabled="{Binding SketchGizmoEditing}" ItemsSource="{Binding SketchGizmoPlanes}" SelectedIndex="{Binding SketchGizmoPlane, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="The plane the next curves are drawn on. Clicking a plane handle on the gizmo changes this too."/>
                </Grid>
                <Button Content="{Binding SketchNormalLabel}" Tag="normal" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch"/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="Axis" Classes="soft" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SketchGizmoAxes}" SelectedIndex="{Binding SketchGizmoAxis, Mode=TwoWay}" HorizontalAlignment="Stretch" ToolTip.Tip="The gizmo axis to draw along. Clicking an arrow on the gizmo changes this too."/>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Content="Draw along axis" Tag="axis" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Content="Release axis" Tag="axis-free" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch"/>
                </Grid>
                <CheckBox Content="Free 3D editing (not limited to the plane)" IsChecked="{Binding SketchFreeEditing, Mode=TwoWay}" ToolTip.Tip="Let the gizmo lift points off their drawing plane in any direction. Off keeps them on it."/>
                <CheckBox Content="Show the drawing plane" IsChecked="{Binding GizmoShowWorkPlane, Mode=TwoWay}" ToolTip.Tip="Draw the plane you are drawing on as a faint sheet with an outline, so you can see where it is. Handy when you want to save a plane from the gizmo."/>
                <TextBlock Text="Drawing planes in this sketch" Classes="soft"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox IsEnabled="{Binding SketchGizmoEditing}" ItemsSource="{Binding SketchPlaneChoices}" SelectedIndex="{Binding SketchPlaneChoice, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" IsEnabled="{Binding SketchGizmoEditing}" Content="+ Plane" Tag="new" Click="OnSketchAction" Classes="studioAction"/>
                </Grid>
                <Button Content="Reset gizmo" Tag="reset-gizmo" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasGizmoPlanes}" Spacing="6">
                <TextBlock Text="Saved gizmos and planes" Classes="section"/>
                <TextBlock Text="Save where the gizmo is now as a plane, or pick a saved one to snap back to it. Saved ones also appear in the model tree." Classes="soft" TextWrapping="Wrap" FontSize="11.5"/>
                <ComboBox ItemsSource="{Binding SketchDatumChoices}" SelectedIndex="{Binding SketchDatumChoice, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <TextBox Text="{Binding SketchDatumName, Mode=TwoWay}" Watermark="Name (optional)"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Content="Save this plane" Tag="save-plane" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Content="Save gizmo" Tag="save-gizmo" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch"/>
                </Grid>
                <Grid ColumnDefinitions="*,92" ColumnSpacing="7"><TextBlock Text="Offset the new plane (mm)" Classes="soft" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Value="{Binding SketchDatumPlaneOffset, Mode=TwoWay}" FormatString="0.###" ShowButtonSpinner="False" AutomationProperties.Name="New plane offset"/></Grid>
                <Button Content="Update the selected one" Tag="update-datum" Click="OnSketchAction" Classes="studioAction" HorizontalAlignment="Stretch" ToolTip.Tip="Re-save the picked plane or gizmo from where the gizmo is now."/>
            </StackPanel>
            <Border Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4"><c:GizmoPreview Session="{Binding Session}" Height="190" AutomationProperties.Name="Live gizmo preview"/></Border>
            <TextBlock Text="Handle visibility" Classes="section"/>
            <ComboBox Name="GizmoDisplayPicker" ItemsSource="{Binding GizmoDisplayModes}" SelectedIndex="{Binding GizmoDisplayMode, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
            <StackPanel IsVisible="{Binding GizmoCustomVisibility}" Spacing="3">
                <CheckBox Content="Move arrows" IsChecked="{Binding GizmoShowMove, Mode=TwoWay}"/>
                <CheckBox Content="Rotation rings" IsChecked="{Binding GizmoShowRotate, Mode=TwoWay}"/>
                <CheckBox Content="Scale handles" IsChecked="{Binding GizmoShowScale, Mode=TwoWay}"/>
            </StackPanel>
            <CheckBox Content="Show axis labels" IsChecked="{Binding GizmoShowLabels, Mode=TwoWay}"/>
            <TextBlock Text="Visible axes" Classes="section"/>
            <Grid ColumnDefinitions="*,*,*"><CheckBox Content="X / U" IsChecked="{Binding GizmoShowX, Mode=TwoWay}"/><CheckBox Grid.Column="1" Content="Y / V" IsChecked="{Binding GizmoShowY, Mode=TwoWay}"/><CheckBox Grid.Column="2" Content="Z / N" IsChecked="{Binding GizmoShowZ, Mode=TwoWay}"/></Grid>
            <CheckBox Content="Show plane movement handles in sketches" IsChecked="{Binding GizmoShowPlanes, Mode=TwoWay}"/>
            <TextBlock Text="Handle size and picking" Classes="section" Margin="0,6,0,0"/>
            <Grid ColumnDefinitions="*,92,24" ColumnSpacing="7"><TextBlock Text="Handle size on screen" Classes="soft" VerticalAlignment="Center"/><NumericUpDown ShowButtonSpinner="False" Grid.Column="1" Value="{Binding GizmoScreenSize, Mode=TwoWay}" Minimum="56" Maximum="180" Increment="8" FormatString="0"/><TextBlock Grid.Column="2" Text="px" Classes="meta" VerticalAlignment="Center"/></Grid>
            <Grid ColumnDefinitions="*,92,24" ColumnSpacing="7"><TextBlock Text="Line width" Classes="soft" VerticalAlignment="Center"/><NumericUpDown ShowButtonSpinner="False" Grid.Column="1" Value="{Binding GizmoLineWidth, Mode=TwoWay}" Minimum="1" Maximum="5" Increment="0.5" FormatString="0.#"/><TextBlock Grid.Column="2" Text="px" Classes="meta" VerticalAlignment="Center"/></Grid>
            <Grid ColumnDefinitions="*,92,24" ColumnSpacing="7"><TextBlock Text="Pick tolerance" Classes="soft" VerticalAlignment="Center"/><NumericUpDown ShowButtonSpinner="False" Grid.Column="1" Value="{Binding GizmoHitTolerance, Mode=TwoWay}" Minimum="4" Maximum="18" Increment="1" FormatString="0"/><TextBlock Grid.Column="2" Text="px" Classes="meta" VerticalAlignment="Center"/></Grid>
            <CheckBox Content="Snap gizmo transforms" IsChecked="{Binding GizmoSnapping, Mode=TwoWay}" Margin="0,6,0,0"/>
            <StackPanel IsEnabled="{Binding GizmoSnapping}" Spacing="7">
                <Grid ColumnDefinitions="*,92,24" ColumnSpacing="7"><TextBlock Text="Move increment" Classes="soft" VerticalAlignment="Center"/><NumericUpDown ShowButtonSpinner="False" Grid.Column="1" Value="{Binding GizmoMoveStep, Mode=TwoWay}" Minimum="0.001" Maximum="10000" Increment="0.5" FormatString="0.###"/><TextBlock Grid.Column="2" Text="mm" Classes="meta" VerticalAlignment="Center"/></Grid>
                <Grid ColumnDefinitions="*,92,24" ColumnSpacing="7"><TextBlock Text="Angle increment" Classes="soft" VerticalAlignment="Center"/><NumericUpDown ShowButtonSpinner="False" Grid.Column="1" Value="{Binding GizmoAngleStep, Mode=TwoWay}" Minimum="0.1" Maximum="180" Increment="5" FormatString="0.#"/><TextBlock Grid.Column="2" Text="°" Classes="meta" VerticalAlignment="Center"/></Grid>
                <Grid ColumnDefinitions="*,92,24" ColumnSpacing="7"><TextBlock Text="Scale increment" Classes="soft" VerticalAlignment="Center"/><NumericUpDown ShowButtonSpinner="False" Grid.Column="1" Value="{Binding GizmoScaleStep, Mode=TwoWay}" Minimum="0.1" Maximum="100" Increment="5" FormatString="0.#"/><TextBlock Grid.Column="2" Text="%" Classes="meta" VerticalAlignment="Center"/></Grid>
            </StackPanel>
            <TextBlock Text="Shared by sketch, freeform and control-point gizmos. Hold Alt during a drag to bypass snapping. Axis colors identify X, Y and Z; the highlight follows your theme accent." Classes="meta" TextWrapping="Wrap"/>
            <Button Content="Reset gizmo preferences" Classes="studioAction" Click="OnReset" HorizontalAlignment="Stretch"/>

        </StackPanel>
    </Expander>
    </ScrollViewer>
    <Border Name="GizmoActionBar" Grid.Row="1" Padding="12,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBg}">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding GizmoIsNotDatum}">
                <Button Name="CancelGizmoPlacement" Content="Cancel placement" Classes="studioAction" Click="OnCancelPlacement" IsVisible="{Binding GizmoPositioning}" ToolTip.Tip="Restore the previous gizmo binding."/>
                <Button Name="BindGizmoSelection" Grid.Column="1" Content="Bind to selection" Classes="studioAction primary" Click="OnBind" IsVisible="{Binding GizmoPositioning}" IsEnabled="{Binding CanPlaceGizmo}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Content="Hide gizmo" Classes="studioAction" Click="OnCancelPlacement" IsVisible="{Binding GizmoIsDatum}" HorizontalAlignment="Left"/>
                <Button Name="FinishGizmoPanel" Grid.Column="1" Content="Done" Classes="primary" Click="OnReturn"/>
            </Grid>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
