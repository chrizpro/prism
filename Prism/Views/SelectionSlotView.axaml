<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Prism.Controls"
             x:Class="Prism.Views.SelectionSlotView"
             IsVisible="{Binding IsVisible}" Margin="0,0,0,12">
    <UserControl.Styles>
        <Style Selector="Border.selectionEditor"><Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/></Style>
        <Style Selector="Border.selectionEditor.active"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
        <Style Selector="Button.pick">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox.picks">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.picks ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.picks ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
            <Button Name="ExpandButton" Classes="tool" Click="OnToggleExpanded" Padding="0" Width="18" Height="22" ToolTip.Tip="Expand or collapse selections"/>
            <TextBlock Grid.Column="1" Text="{Binding PickerLabel}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="soft" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Classes="tool" Content="×" Click="OnClear" Padding="3,0" Height="22" ToolTip.Tip="Clear all selections"/>
        </Grid>
        <Button Name="SummaryButton" Classes="pick" IsVisible="{Binding !IsExpanded}" Click="OnStartPicking" ToolTip.Tip="Expand and edit selections"><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/></Button>
        <StackPanel IsVisible="{Binding IsExpanded}" Spacing="4">
            <StackPanel IsVisible="{Binding HasSelectionRules}" Spacing="5" Margin="0,0,0,4">
                <TextBlock Text="Selection intent" Classes="soft" FontSize="11"/>
                <ComboBox ItemsSource="{Binding SelectionRules}" SelectedIndex="{Binding SelectionRuleIndex}" SelectionChanged="OnIntentChanged" HorizontalAlignment="Stretch" MinHeight="32" ToolTip.Tip="Choose a whole profile, pick edges individually, or build a connected chain."/>
                <CheckBox Content="Other path" IsChecked="{Binding OtherPath}" IsVisible="{Binding IsPartialLoop}" ToolTip.Tip="After picking the first and last edges, follow the other side of the loop."/>
            </StackPanel>
            <StackPanel IsVisible="{Binding SmartPick}" Spacing="5" Margin="0,0,0,4">
                <TextBlock Text="Select by" Classes="soft" FontSize="11"/>
                <ComboBox ItemsSource="{Binding PickIntents}" SelectedIndex="{Binding IntentIndex}" SelectionChanged="OnIntentChanged" HorizontalAlignment="Stretch" MinHeight="32" ToolTip.Tip="A click can pick the whole hole, slot, pocket or boss it lands on, one face, a chain of smoothly joined faces, every feature of the same size, or the whole pattern it is part of."/>
            </StackPanel>
            <Border Name="SelectionBorder" Classes="selectionEditor" Classes.active="{Binding IsActive}" Background="{DynamicResource FieldBg}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <StackPanel>
                    <ListBox Name="Rows" Classes="picks" Focusable="True" MaxHeight="128" SelectionChanged="OnSelectionChanged" KeyDown="OnRowsKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.IsScrollChainingEnabled="False">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,Auto,20,*,26" ColumnSpacing="5" Height="30" Margin="4,0" Background="Transparent" PointerEntered="OnRowEnter" PointerExited="OnRowExit">
                                    <Border IsVisible="{Binding Ordered}" Background="Transparent" Cursor="SizeNorthSouth" Width="12" PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost" ToolTip.Tip="Drag to reorder">
                                        <TextBlock Text="⠿" Classes="soft" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" IsVisible="{Binding Ordered}" Text="{Binding Number}" Classes="soft" VerticalAlignment="Center" MinWidth="12"/>
                                    <c:IconView Grid.Column="2" Icon="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}"/>
                                    <Button Grid.Column="4" Classes="tool" Content="×" Padding="3,0" Click="OnRemove" ToolTip.Tip="Remove this selection"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Name="PickButton" Classes="pick" Click="OnStartPicking"/>
                </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding Ordered}">
                <TextBlock Text="Drag to reorder" Classes="faint" FontSize="11" VerticalAlignment="Center"/>
                <Button Name="MoveUpButton" Grid.Column="1" Classes="tool" Content="↑" Click="OnMoveUp" Padding="6,1" ToolTip.Tip="Move profile up (Alt+Up)"/>
                <Button Name="MoveDownButton" Grid.Column="2" Classes="tool" Content="↓" Click="OnMoveDown" Padding="6,1" ToolTip.Tip="Move profile down (Alt+Down)"/>
            </Grid>
            <TextBlock Name="PickHint" Classes="soft" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</UserControl>
