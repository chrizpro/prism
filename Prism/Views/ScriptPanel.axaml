<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prism.Views.ScriptPanel">
    <UserControl.Styles>
        <!-- the theme paints a focused text box solid, which would hide the colored text underneath -->
        <Style Selector="TextBox#Editor /template/ Border#PART_BorderElement, TextBox#Console /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox#Editor:focus /template/ Border#PART_BorderElement, TextBox#Console:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox#Editor:pointerover /template/ Border#PART_BorderElement, TextBox#Console:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*,5,180,Auto">
            <!-- the script's name, then its actions -->
            <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="8">
                    <TextBlock Name="NameText" Classes="panelTitle" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel>
                        <Button Name="RunBtn" Classes="primary" Content="▶  Run" Click="OnRun" ToolTip.Tip="Run the script (F5)" Padding="14,5" Margin="0,0,6,4"/>
                        <Button Name="StopBtn" Classes="ghost" Content="■  Stop" Click="OnStop" ToolTip.Tip="Stop the running script (Shift+F5)" Padding="12,5" IsEnabled="False" Margin="0,0,6,4"/>
                        <Border Width="1" Background="{DynamicResource Line}" Margin="4,4,10,4"/>
                        <Button Classes="ghost" Content="New" Click="OnNew" Padding="10,5" ToolTip.Tip="Start a new script" Margin="0,0,6,4"/>
                        <Button Name="OpenBtn" Classes="ghost" Content="Open ▾" Click="OnOpenMenu" Padding="10,5" ToolTip.Tip="Open one of your scripts or an example" Margin="0,0,6,4"/>
                        <Button Classes="ghost" Content="Save" Click="OnSave" Padding="10,5" ToolTip.Tip="Save the script (Ctrl+S)" Margin="0,0,6,4"/>
                        <Button Classes="ghost" Content="✦ AI" Click="OnAskAi" Padding="10,5" ToolTip.Tip="Write this script with the assistant — it replaces the whole script, and ⟲ undoes a rewrite" Margin="0,0,6,4"/>
                        <Button Name="RollbackBtn" Classes="ghost" Content="⟲" Click="OnRollback" Padding="8,5" IsEnabled="False" ToolTip.Tip="Roll back the assistant's last rewrite" Margin="0,0,6,4"/>
                        <Border Width="1" Background="{DynamicResource Line}" Margin="4,4,10,4"/>
                        <Button Classes="ghost" Content="Edit in ▾" Click="OnEditInMenu" Padding="10,5" ToolTip.Tip="Open this script in your own editor. The library sits next to your scripts, so it works there too." Margin="0,0,6,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- editor: line numbers and text scroll together. The colored text sits under a transparent text box that does the typing. -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBg}">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Name="Gutter" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5" LineHeight="18" TextAlignment="Right"
                               Foreground="{DynamicResource InkFaint}" Padding="14,12,10,12" MinWidth="44"/>
                    <Panel Grid.Column="1">
                        <TextBlock Name="Code" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5" LineHeight="18" Padding="6,12,16,12" TextWrapping="NoWrap"/>
                        <TextBox Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                                 Foreground="Transparent" CaretBrush="{DynamicResource Ink}" SelectionBrush="#554C94FF" SelectionForegroundBrush="Transparent"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5" LineHeight="18" Padding="6,12,16,12" MinHeight="120"
                                 KeyDown="OnEditorKeyDown"/>
                    </Panel>
                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Row="2" Background="Transparent" Height="5" ResizeDirection="Rows"/>

            <!-- console -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel Margin="14,8,10,4">
                        <Button DockPanel.Dock="Right" Classes="tool" Content="Clear" Click="OnClear" Padding="8,2" FontSize="11"/>
                        <TextBlock Text="Console" Classes="panelTitle" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Name="Console" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Padding="14,4,14,10"/>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="14,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <TextBlock Name="StatusText" Classes="faint" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
