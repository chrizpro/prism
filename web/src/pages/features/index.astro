---
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import { features } from '../../data/features'
import { toolsIn } from '../../data/catalog'
import { href } from '../../config'
---
<Base title="Features" description="Solid modeling, sketching, surfaces, freeform, simulation, CAM, assemblies, rendering, scanning, ECAD and scripting in Prism.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Features</span>
        <h1>One model. Every step of the job.</h1>
        <p>Prism keeps design, analysis and manufacturing in the same document, so a change in the model reaches every study, toolpath and render.</p>
      </div>
      <div class="list">
        {features.map(f => (
          <a class="item" href={href(`/features/${f.slug}`)} style={`--accent:${f.accent}`}>
            <div class="media">
              {f.image
                ? <Image src={f.image} alt="" width={560} />
                : <div class="placeholder"><span>{f.tabs.join(' · ')}</span></div>}
            </div>
            <div class="body">
              <span class="kicker" style="color:var(--accent)">{f.kicker}</span>
              <h2>{f.name}</h2>
              <p class="muted">{f.title}</p>
              <span class="meta">{toolsIn(...f.tabs)} tools · {f.tabs.join(', ')}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: 12px 0 16px; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; }
  @media (max-width: 400px) { .list { grid-template-columns: 1fr; } }
  .item { display: grid; border-radius: var(--radius); overflow: hidden; background: var(--panel); border: 1px solid var(--line); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .item:hover { border-color: var(--accent); transform: translateY(-3px); }
  .media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-2); border-bottom: 1px solid var(--line); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .placeholder {
    height: 100%; display: grid; place-items: center; padding: 24px; text-align: center;
    background: radial-gradient(70% 90% at 30% 20%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 70%), linear-gradient(135deg, #0e1a2d, #0a1220);
  }
  .placeholder span { font-family: var(--display); font-size: 1.4rem; font-weight: 600; color: var(--text); opacity: 0.85; }
  .body { padding: 22px 24px 26px; display: grid; gap: 6px; }
  h2 { font-size: 1.5rem; }
  .meta { margin-top: 8px; font-size: 0.82rem; color: var(--muted); }
</style>
