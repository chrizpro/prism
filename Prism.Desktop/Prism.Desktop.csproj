<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- This executable is not referenced by other projects. Avoid Avalonia rewriting its intermediate reference assembly. -->
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <NativeLibraryDirectory Condition="'$(NativeLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)..\native\bin</NativeLibraryDirectory>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationIcon>..\Prism\Assets\prism.ico</ApplicationIcon>
        <Product>Prism</Product>
        <!-- Packaging passes -p:Version; local builds report this one. -->
        <Version>0.2.0</Version>
        <Title>Prism</Title>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Native Open CASCADE kernel (build with native/build.ps1) -->
        <None Include="$(NativeLibraryDirectory)\*.dll;$(NativeLibraryDirectory)\*.so*;$(NativeLibraryDirectory)\*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <None Include="$(NativeLibraryDirectory)\licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Prism\Prism.csproj"/>
    </ItemGroup>
</Project>
