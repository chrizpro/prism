<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Prism.Controls.PanelStepHeader" x:Name="Heading">
    <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="12,8">
        <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Step, ElementName=Heading}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Title, ElementName=Heading}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
