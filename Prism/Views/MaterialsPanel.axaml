<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Prism.Core"
             xmlns:vm="using:Prism.ViewModels"
             xmlns:c="using:Prism.Controls"
             x:Class="Prism.Views.MaterialsPanel" Foreground="{DynamicResource Ink}">
    <UserControl.Styles><StyleInclude Source="avares://Prism/Styles/Studio.axaml"/></UserControl.Styles>
    <DockPanel Background="{DynamicResource PanelBg}">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,11">
            <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                <c:IconView Icon="materials" Width="22" Height="22"/>
                <TextBlock Grid.Column="1" Text="Appearance studio" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="×" Classes="studioLink" Click="OnClose" ToolTip.Tip="Close appearance studio"/>
            </Grid>
        </Border>
        <TabControl Name="StudioTabs">
            <TabItem Header="Appearance">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Finishes update live · material data stays assigned." FontSize="11" Classes="meta" TextWrapping="Wrap"/>
                            <Button Name="ResetFinish" Content="Reset finish" Classes="studioAction" Click="OnResetFinish" IsEnabled="{Binding CanApplyAppearance}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,10" Spacing="9">
                            <c:PanelStepHeader Step="1" Title="Selection and material" Margin="-12,-10,-12,0"/>
                            <TextBlock Text="{Binding MatTarget}" Classes="meta" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource PanelAlt}" CornerRadius="4" Padding="10">
                                <Grid ColumnDefinitions="54,*" ColumnSpacing="10">
                                    <c:FinishPreview Width="52" Height="52" Color="{Binding AppearanceColor}" Gloss="{Binding LookGloss}" Pattern="{Binding AppearancePattern}"/>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AssignedText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Button Content="Change material…" Classes="studioLink" Padding="0,2" Click="OnShowLibrary" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button Name="GenericAppearance" Content="Generic appearance" Click="OnGenericAppearance" Classes="studioAction" IsEnabled="{Binding CanApplyAppearance}" HorizontalAlignment="Stretch" ToolTip.Tip="Start with white, nonmetallic appearance and no pattern; then import images or adjust the surface."/>
                            <Expander Header="My appearances" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Reusable looks only · engineering properties stay assigned." Classes="meta" TextWrapping="Wrap"/>
                                    <ComboBox Name="SavedAppearanceLibrary" ItemsSource="{Binding SavedAppearances}" SelectedItem="{Binding SelectedSavedAppearance}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate><DataTemplate DataType="core:SavedAppearance"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <Button Content="Apply" Classes="studioAction" Click="OnApplySavedAppearance" IsEnabled="{Binding CanApplyAppearance}" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="Remove saved" Classes="studioAction" Click="OnRemoveSavedAppearance" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <TextBlock Text="Appearance name" Classes="meta"/>
                                    <TextBox Text="{Binding SavedAppearanceName}" Watermark="Appearance name" MaxLength="80"/>
                                    <Button Content="Save as appearance…" Classes="studioAction" Click="OnSaveAppearance" IsEnabled="{Binding CanApplyAppearance}" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding AppearanceLibraryStatus}" Classes="meta" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <Expander Name="FinishOptions" Header="Finish presets" HorizontalAlignment="Stretch">

                            <ListBox Name="FinishLibrary" Classes="studioList finishes" ItemsSource="{Binding FinishPresets}" SelectedItem="{Binding ActiveFinishPreset, Mode=OneWay}" SelectionChanged="OnFinishPicked" Background="Transparent" Padding="0" IsEnabled="{Binding CanApplyAppearance}">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:FinishPreset">
                                        <StackPanel Spacing="4" Margin="0,3" ToolTip.Tip="{Binding Name}">
                                            <c:FinishPreview Width="66" Height="66" Color="{Binding Color}" Gloss="{Binding Gloss}" Pattern="{Binding Pattern}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MinHeight="28"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Expander>
                            <StackPanel IsEnabled="{Binding CanApplyAppearance}">
                                <c:PanelStepHeader Step="2" Title="Surface settings" Margin="-12,6,-12,8"/>
                                <StackPanel Spacing="6">

                                <Button Name="ChooseColor" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="9,7">
                                    <Button.Content>
                                        <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                            <Border Background="{Binding AppearanceColor, Converter={x:Static c:ArgbToBrush.Instance}}" CornerRadius="3" Height="20"/>
                                            <TextBlock Grid.Column="1" Text="Base color" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Edit…" Classes="meta" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button.Content>
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <StackPanel Spacing="8" Width="240">
                                                <TextBlock Text="Choose a color" FontWeight="SemiBold"/>
                                                <c:ColorWheel Name="PickerWheel" Color="{Binding AppearanceColor, Mode=OneWay}" ColorPicked="OnColorWheelPicked" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Brightness" Classes="meta"/>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding ColorValue}"/>
                                                <Button Name="ScreenPicker" Content="Pick from screen…" Click="OnScreenPick" HorizontalAlignment="Stretch"/>
                                                <ItemsControl Name="Swatches">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <TextBlock Text="Recent" Classes="meta" FontSize="11"/>
                                                <ItemsControl ItemsSource="{Binding RecentAppearanceColors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="24" Height="24" Margin="0,0,6,4" Padding="0" CornerRadius="12" Background="{Binding Converter={x:Static c:ArgbToBrush.Instance}}" Tag="{Binding}" Click="OnRememberedColor" ToolTip.Tip="Apply color"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Saved" Classes="meta" FontSize="11"/>
                                                <ItemsControl ItemsSource="{Binding SavedAppearanceColors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="24" Height="24" Margin="0,0,6,4" Padding="0" CornerRadius="12" Background="{Binding Converter={x:Static c:ArgbToBrush.Instance}}" Tag="{Binding}" Click="OnRememberedColor" ToolTip.Tip="Apply color"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="Save current color" Click="OnSaveColor" HorizontalAlignment="Stretch"/>
                                                <TextBlock Text="Arrow keys adjust hue and saturation. Screen sampling captures the displayed color." Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox Name="HexBox" Text="{Binding ColorHex}" Watermark="#RRGGBB · rgb(...) · hsl(...) · hsv(...)" Padding="8,6" KeyDown="OnHexKey" LostFocus="OnColorCodeLostFocus" ToolTip.Tip="Press Enter to apply HEX, RGB, HSL or HSV. Colors use sRGB."/>
                                <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                    <TextBlock Text="Roughness" Classes="meta" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LookRoughness}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LookRoughness, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding AppearanceStatus}" Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="Surface finish" Classes="meta" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding SurfacePatterns}" SelectedIndex="{Binding LookPattern}" HorizontalAlignment="Stretch"/>
                                <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                    <TextBlock Text="Pattern size (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding LookPatternScale}" Minimum=".1" Maximum="10000" Increment="1" FormatString="0.0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                    <TextBlock Text="Grain angle (°)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding LookPatternAngle}" Minimum="-360" Maximum="360" Increment="15" FormatString="0"/>
                                </Grid>
                                <Expander Name="GradientOptions" Header="Color gradient" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Margin="0,6">
                                        <ComboBox ItemsSource="{Binding GradientModes}" SelectedIndex="{Binding GradientMode}" HorizontalAlignment="Stretch"/>
                                        <StackPanel Spacing="8" IsVisible="{Binding HasColorGradient}">
                                            <TextBlock Text="Direction / projection axis" Classes="meta"/>
                                            <ComboBox ItemsSource="{Binding GradientAxes}" SelectedIndex="{Binding GradientDirection}" HorizontalAlignment="Stretch"/>
                                            <Grid ColumnDefinitions="*,112" ColumnSpacing="6">
                                                <TextBlock Text="End / corner 2" Classes="meta" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding GradientColor2, Mode=OneWay}" Tag="2" KeyDown="OnGradientColorKey" LostFocus="OnGradientColorLostFocus"/>
                                            </Grid>
                                            <Grid IsVisible="{Binding HasFreeformGradient}" ColumnDefinitions="*,112" ColumnSpacing="6">
                                                <TextBlock Text="Corner 3 (freeform)" Classes="meta" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding GradientColor3, Mode=OneWay}" Tag="3" KeyDown="OnGradientColorKey" LostFocus="OnGradientColorLostFocus"/>
                                            </Grid>
                                            <Grid IsVisible="{Binding HasFreeformGradient}" ColumnDefinitions="*,112" ColumnSpacing="6">
                                                <TextBlock Text="Corner 4 (freeform)" Classes="meta" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding GradientColor4, Mode=OneWay}" Tag="4" KeyDown="OnGradientColorKey" LostFocus="OnGradientColorLostFocus"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                                <TextBlock Text="Size (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding GradientSize}" Minimum=".1" Maximum="10000" Increment="1" FormatString="0.0"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                                <TextBlock Text="Offset (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding GradientOffset}" Minimum="-10000" Maximum="10000" Increment="1" FormatString="0.0"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                                <TextBlock Text="Rotation (°)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding GradientAngle}" Minimum="-360" Maximum="360" Increment="15" FormatString="0"/>
                                            </Grid>
                                            <TextBlock Text="Base color is the first stop. Freeform blends four corners on the selected plane." Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Name="WeatherOptions" Header="Weathering" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Margin="0,6">
                                        <ComboBox ItemsSource="{Binding WeatheringModes}" SelectedIndex="{Binding WeatheringMode}" HorizontalAlignment="Stretch"/>
                                        <StackPanel Spacing="8" IsVisible="{Binding HasWeathering}">
                                            <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                                <TextBlock Text="Coverage" Classes="meta" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding WeatherCoverage}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WeatherCoverage, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                                <TextBlock Text="Patch size (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding WeatherSize}" Minimum=".1" Maximum="10000" Increment="1" FormatString="0.0"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                                <TextBlock Text="Roughness" Classes="meta" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding WeatherRoughness}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WeatherRoughness, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                                <TextBlock Text="Variation seed" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding WeatherSeed}" Minimum="0" Maximum="9999" Increment="1" FormatString="0"/>
                                            </Grid>
                                            <CheckBox Content="Concentrate near bottom" IsChecked="{Binding WeatherBottom}"/>
                                            <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                                <TextBlock Text="Fade height (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding WeatherHeight}" Minimum=".1" Maximum="10000" Increment="1" FormatString="0.0"/>
                                            </Grid>
                                            <TextBlock Text="Visual weathering preserves geometry and engineering data." Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                                                <Expander Name="ImageOptions" Header="Image textures" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Margin="0,6">
                                        <TextBlock Text="{Binding ColorMapStatus}" Classes="meta"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Button Content="Import color…" Tag="color" Click="OnImportMap" HorizontalAlignment="Stretch"/>
                                            <Button Content="×" Tag="color" Click="OnClearMap" ToolTip.Tip="Remove color image"/>
                                        </Grid>
                                        <TextBlock Text="{Binding RoughnessMapStatus}" Classes="meta"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Button Content="Import roughness…" Tag="roughness" Click="OnImportMap" HorizontalAlignment="Stretch"/>
                                            <Button Content="×" Tag="roughness" Click="OnClearMap" ToolTip.Tip="Remove roughness image"/>
                                        </Grid>
                                        <TextBlock Text="{Binding BumpMapStatus}" Classes="meta"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Button Content="Import bump…" Tag="bump" Click="OnImportMap" HorizontalAlignment="Stretch"/>
                                            <Button Content="×" Tag="bump" Click="OnClearMap" ToolTip.Tip="Remove bump image"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DecalMapStatus}" Classes="meta"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Button Content="Import decal…" Tag="decal" Click="OnImportMap" HorizontalAlignment="Stretch"/>
                                            <Button Content="×" Tag="decal" Click="OnClearMap" ToolTip.Tip="Remove decal image"/>
                                        </Grid>
                                        <TextBlock Text="A decal keeps its transparency and is laid flat once over the texture placement (turn Repeat off to keep the edges clear)." Classes="meta" TextWrapping="Wrap"/>
                                        <TextBlock Text="Projection" Classes="meta"/>
                                        <ComboBox ItemsSource="{Binding TextureProjections}" SelectedIndex="{Binding TextureProjectionMode}" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Projection axis" Classes="meta"/>
                                        <ComboBox ItemsSource="{Binding GradientAxes}" SelectedIndex="{Binding TextureProjectionAxis}" HorizontalAlignment="Stretch"/>
                                        <Button Content="Center projection on selection" Click="OnCenterProjection" HorizontalAlignment="Stretch"/>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Repeat size (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding TextureSize}" Minimum=".1" Maximum="10000" Increment="1" FormatString="0.0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Rotation (°)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding TextureAngle}" Minimum="-360" Maximum="360" Increment="15" FormatString="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Offset X (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding TextureOffsetX}" Minimum="-100000" Maximum="100000" Increment="1" FormatString="0.0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Offset Y (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding TextureOffsetY}" Minimum="-100000" Maximum="100000" Increment="1" FormatString="0.0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Offset Z (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding TextureOffsetZ}" Minimum="-100000" Maximum="100000" Increment="1" FormatString="0.0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Height / width" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding TextureAspect}" Minimum=".01" Maximum="100" Increment=".1" FormatString="0.00"/>
                                        </Grid>
                                        <CheckBox Content="Repeat image" IsChecked="{Binding TextureRepeat}"/>
                                        <TextBlock Text="Images are embedded. Choose projection and placement without UV setup. Color images tint the base color; use white for the original image colors." Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Name="ReflectionOptions" Header="Reflection and detail" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Margin="0,6">
                                        <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                            <TextBlock Text="Metallic" Classes="meta" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LookMetal}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LookMetal, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                            <TextBlock Text="Bump depth" Classes="meta" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SurfaceBump}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SurfaceBump, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                            <TextBlock Text="Clear coat" Classes="meta" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding CoatAmount}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CoatAmount, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                            <TextBlock Text="Coat rough." Classes="meta" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding CoatRoughness}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CoatRoughness, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                            <TextBlock Text="Anisotropy" Classes="meta" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum=".95" Value="{Binding SurfaceAnisotropy}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SurfaceAnisotropy, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Brush direction (°)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding AnisotropyAngle}" Minimum="-360" Maximum="360" Increment="15" FormatString="0"/>
                                        </Grid>
                                        <TextBlock Text="Bump uses the imported height image, or procedural grain when no image is assigned. Clear coat adds a dielectric reflection layer." Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Name="TransmissionOptions" Header="Glass and transparent surfaces" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Margin="0,6">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <Button Content="Clear glass" Click="OnClearGlass"/>
                                            <Button Grid.Column="1" Content="Frosted glass" Click="OnFrostedGlass"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="84,*,32" ColumnSpacing="4">
                                            <TextBlock Text="Transmission" Classes="meta" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SurfaceTransmission}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SurfaceTransmission, StringFormat=F2}" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Index of refraction" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding SurfaceIor}" Minimum="1" Maximum="3" Increment=".05" FormatString="0.00"/>
                                        </Grid>
                                        <TextBlock Text="Tint at reference depth" Classes="meta"/>
                                        <TextBox Name="AbsorptionTint" Text="{Binding AbsorptionColor, Mode=OneWay}" KeyDown="OnAbsorptionKey" LostFocus="OnAbsorptionLostFocus"/>
                                        <Grid ColumnDefinitions="*,108" ColumnSpacing="6">
                                            <TextBlock Text="Reference depth (mm)" Classes="meta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding AbsorptionDistance}" Minimum=".01" Maximum="100000" Increment="1" FormatString="0.0"/>
                                        </Grid>
                                        <TextBlock Text="White tint is clear. Longer paths absorb more color. Surface roughness controls frosting. Closed solids give correct thickness; final rendering shows refraction while the viewport is approximate." Classes="meta" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                            <Expander Header="Assigned engineering properties" IsVisible="{Binding HasAssignedData}" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding AssignedData}" TextWrapping="Wrap" FontSize="11"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Materials">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBg}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding MatTarget}" Classes="meta" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" Classes="studioAction primary" Content="Apply material" Click="OnApply" IsEnabled="{Binding HasMaterial}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="1" Classes="studioAction" Content="Close" Click="OnClose"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="14,14,14,10" Spacing="6">
                <TextBlock Text="Material library" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding AssignedText}" Classes="meta" TextWrapping="Wrap"/>
                <Expander Header="Assigned engineering properties" IsVisible="{Binding HasAssignedData}" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding AssignedData}" TextWrapping="Wrap" FontSize="11"/>
                </Expander>

                <TextBox Text="{Binding MaterialSearch}" Watermark="Search all 125: steel, nylon, heat sink..." Padding="8,6" CornerRadius="5" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding MaterialFamilies}" Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MaterialFamilyRow">
                            <Button Classes="matChip" Classes.on="{Binding IsActive}" Tag="{Binding Index}" Click="OnFamily" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color, Converter={x:Static c:ArgbToBrush.Instance}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Count}" Classes="meta" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox Classes="field" ItemsSource="{Binding MaterialSorts}" SelectedIndex="{Binding MaterialSortIndex}" HorizontalAlignment="Stretch" ToolTip.Tip="Sort by"/>
                <TextBlock Text="{Binding MatResultCount}" Classes="meta"/>

                <ListBox Classes="studioList" ItemsSource="{Binding MaterialList}" SelectedItem="{Binding SelectedMaterialRow}" MaxHeight="168" Background="Transparent" DoubleTapped="OnListDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:MaterialRow">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Color, Converter={x:Static c:ArgbToBrush.Instance}}" BorderBrush="#40000000" BorderThickness="1" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" Classes="meta" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Expander Name="CustomMaterialsOptions" Header="My custom materials" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="User-defined — not verified by Prism" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <StackPanel IsVisible="{Binding !EditingCustomMaterial}" Spacing="6">
                            <Button Name="CreateCustomMaterial" Content="Create custom material…" Classes="studioAction primary" Click="OnCreateCustomMaterial" HorizontalAlignment="Stretch"/>
                            <Button Content="Duplicate selected material…" Classes="studioAction" Click="OnBeginCustomMaterial" HorizontalAlignment="Stretch"/>
                            <Button Content="Remove selected custom material" Classes="studioLink" Click="OnRemoveCustomMaterial" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding EditingCustomMaterial}" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Text="Custom material" Classes="section" VerticalAlignment="Center"/>
                                <Button Name="CancelCustomMaterialTop" Grid.Column="1" Content="Cancel" Classes="studioLink" Click="OnCancelCustomMaterial"/>
                            </Grid>
                            <TextBlock Text="Material name" Classes="meta"/>
                            <TextBox Text="{Binding CustomMaterialName}" Watermark="Custom material name" MaxLength="80"/>
                            <ItemsControl ItemsSource="{Binding CustomMaterialInputs}">
                                <ItemsControl.ItemTemplate><DataTemplate DataType="vm:MaterialPropertyInput">
                                    <StackPanel Spacing="3" Margin="0,3"><TextBlock Text="{Binding Label}" Classes="meta" TextWrapping="Wrap"/><TextBox Text="{Binding Text}"/></StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Source / notes (optional)" Classes="meta"/>
                            <TextBox Text="{Binding CustomMaterialSource}" Watermark="Optional source / notes" MaxLength="2000"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Name="SaveCustomMaterial" Content="Save material" Classes="studioAction primary" Click="OnSaveCustomMaterial" HorizontalAlignment="Stretch"/>
                                <Button Name="CancelCustomMaterial" Grid.Column="1" Content="Cancel" Classes="studioAction" Click="OnCancelCustomMaterial" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding CustomMaterialStatus}" Classes="meta" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
                <!-- detail card -->
                <StackPanel IsVisible="{Binding HasMaterial}" Spacing="6" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="38" Height="38" CornerRadius="19" Background="{Binding MatColor, Converter={x:Static c:ArgbToBrush.Instance}}" BorderBrush="#40000000" BorderThickness="1"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MatName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MatCategory}" Classes="meta"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MatDataStatus}" Classes="meta" FontSize="11" TextWrapping="Wrap"/>

                    <Border IsVisible="{Binding MatMassNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="10,7">
                        <TextBlock Text="{Binding MatMassNote}" TextWrapping="Wrap"/>
                    </Border>

                    <Button Classes="studioAction" Content="{Binding CompareButtonText}" Click="OnCompare" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>


                    <Expander Header="Library engineering data and sources" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="6">
                    <TextBlock Text="Engineering data" Classes="panelTitle" Margin="0,8,0,2"/>
                    <ItemsControl ItemsSource="{Binding MaterialProps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MatPropLine">
                                <StackPanel Margin="0,3" ToolTip.Tip="{Binding Hint}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Label}" Classes="meta"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Border IsVisible="{Binding HasBar}" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,3,0,0" HorizontalAlignment="Left" Width="150">
                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Bars compare library values; strength measures may have different test bases." Classes="meta" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock Text="{Binding MatEvidence}" Classes="meta" TextWrapping="Wrap" FontSize="11"/>

                    <TextBlock Text="Good for" Classes="panelTitle" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding MatUses}" TextWrapping="Wrap"/>
                    <TextBlock Text="Watch out for" Classes="panelTitle" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding MatWatch}" TextWrapping="Wrap" Foreground="{DynamicResource Gold}"/>
                      </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- compare -->
                <StackPanel IsVisible="{Binding HasCompare}" Spacing="2" Margin="0,12,0,0">
                    <TextBlock Text="Compare" Classes="panelTitle" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding CompareRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CompareRow">
                                <Grid ColumnDefinitions="92,*,*,*" Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Classes="meta" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding A}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{Binding B}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="3" Text="{Binding C}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
