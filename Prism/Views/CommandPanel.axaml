<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cmd="using:Prism.Commands"
             xmlns:c="using:Prism.Controls"
             xmlns:v="using:Prism.Views"
             x:Class="Prism.Views.CommandPanel">
    <UserControl.Styles>
        <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,7"/></Style>
        <Style Selector="TextBlock.good"><Setter Property="Foreground" Value="{DynamicResource Ok}"/></Style>
        <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource Gold}"/></Style>
        <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Style>
        <Style Selector="ToggleButton.operationOption">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.operationOption:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="NumericUpDown.field"><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource FieldBg}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style Selector="NumericUpDown.field /template/ TextBox"><Setter Property="Background" Value="{DynamicResource FieldBg}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style Selector="ComboBox.field"><Setter Property="CornerRadius" Value="4"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="{DynamicResource FieldBg}"/><Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
        <Style Selector="Button.primary"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="13,6"/></Style>
        <Style Selector="Button.ghost"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style Selector="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/></Style>
        <Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="cmd:NumberParam">
            <StackPanel Margin="0,4" IsVisible="{Binding IsVisible}" Spacing="3">
                <Grid ColumnDefinitions="*,112,24" ColumnSpacing="5">
                    <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" Classes="soft" TextWrapping="Wrap"/>
                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Value}" Minimum="{Binding InputMinimum}" Maximum="{Binding InputMaximum}" Increment="{Binding Step}" FormatString="{Binding Format}" ParsingNumberStyle="Float" HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Classes="soft" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding Formula, StringFormat='Formula: {0}'}" IsVisible="{Binding Formula, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource Accent}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding HelpText}" IsVisible="{Binding HelpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="soft" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="cmd:IntParam">
            <StackPanel Margin="0,4" IsVisible="{Binding IsVisible}" Spacing="3">
                <Grid ColumnDefinitions="*,112,24" ColumnSpacing="5">
                    <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" Classes="soft" TextWrapping="Wrap"/>
                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Value}" Minimum="{Binding Min}" Maximum="{Binding Max}" Increment="1" FormatString="0" HorizontalContentAlignment="Right"/>
                </Grid>
                <TextBlock Text="{Binding HelpText}" IsVisible="{Binding HelpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="soft" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="cmd:BoolParam">
            <CheckBox IsChecked="{Binding Value}" Margin="0,3" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding HelpText}"><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/></CheckBox>
        </DataTemplate>
        <DataTemplate DataType="cmd:ChoiceParam">
            <StackPanel Margin="0,5" Spacing="5" IsVisible="{Binding IsVisible}">
                <TextBlock Text="{Binding DisplayLabel}" Classes="soft" TextWrapping="Wrap"/>
                <ComboBox Classes="field" ItemsSource="{Binding Options}" SelectedIndex="{Binding Index}" HorizontalAlignment="Stretch" IsVisible="{Binding !IsIllustrated}"/>
                <c:CommandChoiceView IsVisible="{Binding IsIllustrated}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="cmd:TextParam">
            <StackPanel Margin="0,4" Spacing="4" IsVisible="{Binding IsVisible}">
                <TextBlock Text="{Binding DisplayLabel}" Classes="soft" TextWrapping="Wrap"/>
                <TextBox Classes="field" Text="{Binding Value}" Watermark="{Binding Hint}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="110"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="cmd:ActionParam">
            <Button Classes="ghost" Click="OnActionClick" HorizontalAlignment="Stretch" Margin="0,5,0,0" IsVisible="{Binding IsVisible}"><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/></Button>
        </DataTemplate>
        <DataTemplate DataType="cmd:SelectionSlot"><v:SelectionSlotView/></DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource PanelBg}">
        <Border Grid.Row="0" Padding="12,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="24,*,Auto,Auto" ColumnSpacing="8">
                <c:IconView Icon="{Binding ActiveCommand.Icon}" Width="24" Height="24" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ActiveCommand.DisplayTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActiveCommand.DisplayTitle}"/>
                <Button Grid.Column="2" Classes="tool" Content="?" Padding="4,0">
                    <ToolTip.Tip><TextBlock Text="{Binding ActiveCommand.Hint}" TextWrapping="Wrap" MaxWidth="280"/></ToolTip.Tip>
                </Button>
                <Button Grid.Column="3" Classes="tool" Content="×" Click="OnCancel" Padding="4,0" ToolTip.Tip="Cancel operation (Esc)"/>
            </Grid>
        </Border>
        <ScrollViewer Name="PanelScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,12" Spacing="2">
                <ItemsControl ItemsSource="{Binding ActiveCommand.InputSlots}"/>
                <TextBlock Text="Settings" Classes="section" IsVisible="{Binding ActiveCommand.PanelSettings.Count}"/>
                <ItemsControl ItemsSource="{Binding ActiveCommand.PanelSettings}"/>
                <StackPanel Margin="0,10,0,4" IsVisible="{Binding ActiveCommand.HasAdvancedSettings}" Spacing="6">
                    <ToggleButton Name="AdvancedToggle" Content="Advanced…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="30" Padding="8,4" FontSize="12" CornerRadius="4" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"/>
                    <ItemsControl ItemsSource="{Binding ActiveCommand.AdvancedSettings}" IsVisible="{Binding #AdvancedToggle.IsChecked}"/>
                </StackPanel>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0" IsVisible="{Binding ActiveCommand.ResultSettings.Count}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Result" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ActiveCommand.ResultSettings}"/>
                        <ItemsControl ItemsSource="{Binding ActiveCommand.ResultSlots}"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding ActiveCommand.Results}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="cmd:ResultLine">
                            <StackPanel Margin="0,3" Spacing="2">
                                <TextBlock Text="{Binding Label}" Classes="soft" FontSize="11"/>
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Classes.good="{Binding IsGood}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border IsVisible="{Binding CommandError, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Danger}" BorderThickness="2,0,0,0" CornerRadius="3" Padding="9,8" Margin="0,10,0,0">
                    <TextBlock Text="{Binding CommandError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="12,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <CheckBox Content="Preview" IsChecked="{Binding ActiveCommand.PreviewEnabled}" IsVisible="{Binding ActiveCommand.SupportsPreview}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Enter to confirm · Esc to cancel" Classes="faint" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="1" Classes="ghost" Content="Cancel" Click="OnCancel"/>
                    <Button Grid.Column="2" Classes="primary" Content="{Binding ActiveCommand.CommitText}" Click="OnOk"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
