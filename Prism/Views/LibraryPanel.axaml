<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.ViewModels"
             xmlns:c="using:Prism.Controls"
             x:Class="Prism.Views.LibraryPanel" Foreground="{DynamicResource Ink}">
    <UserControl.Styles><StyleInclude Source="avares://Prism/Styles/Studio.axaml"/></UserControl.Styles>
    <DockPanel Background="{DynamicResource PanelBg}">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,11">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Parts library" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" Classes="studioLink" Click="OnClose" ToolTip.Tip="Close the parts library"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding LibraryStatus}" FontSize="11" Classes="meta" TextWrapping="Wrap"/>
                <Button Content="Insert selected part…" Classes="studioAction" Click="OnInsert" IsEnabled="{Binding SelectedLibraryItem, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,4" Spacing="7">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="{Binding LibraryFolderText}" Classes="meta" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Choose folder…" Classes="studioAction" Click="OnChooseFolder"/>
                <Button Grid.Column="2" Content="↻" Classes="studioLink" Click="OnRescan" ToolTip.Tip="Scan the folder again"/>
            </Grid>
            <TextBox Text="{Binding LibraryFilter}" Watermark="Search name, part number, material, tags…"/>
            <CheckBox Content="Show built-in common parts" IsChecked="{Binding LibraryShowBuiltIn}"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding LibraryGroups}" Margin="12,0,12,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LibraryGroup">
                        <StackPanel Spacing="4" Margin="0,8,0,0">
                            <Border Classes="sectionBar" Margin="-12,0,-12,2"><TextBlock Text="{Binding Header}" Classes="section"/></Border>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:LibraryItem">
                                        <Border Width="104" Margin="0,0,6,6" Padding="4" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                                                Tag="{Binding}" PointerPressed="OnTilePressed" ToolTip.Tip="{Binding ToolTipText}">
                                            <StackPanel Spacing="3">
                                                <Panel Width="94" Height="94">
                                                    <Rectangle Fill="{DynamicResource PanelAlt}" RadiusX="4" RadiusY="4"/>
                                                    <Image Source="{Binding Thumb}" IsVisible="{Binding HasThumb}" Stretch="Uniform"/>
                                                </Panel>
                                                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="30"/>
                                                <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="10" Classes="faint" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
