<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Prism.Controls" x:Class="Prism.Views.SketchSpacePanel">
    <StackPanel Spacing="0">
        <Expander IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Expander.Header><c:PanelStepHeader Step="2" Title="Geometry" Margin="-10,-8" ToolTip.Tip="{Binding ToolPanelHint}"/></Expander.Header>
            <StackPanel Margin="12,0" Spacing="9">
                <CheckBox Name="Enable3DSketch" Content="3D sketch" IsChecked="{Binding Sketch3DEnabled, Mode=TwoWay}" ToolTip.Tip="Draw off the sketch plane. The view switches to perspective; turning it off returns to a flat view."/>
                <StackPanel Name="SpatialSketchControls" IsVisible="{Binding Sketch3DEnabled}" Spacing="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Content="Edit Geometry (E)" Tag="edit" Click="OnAction" Classes.primary="{Binding SketchGeometryEditing}" HorizontalAlignment="Stretch" ToolTip.Tip="Click points or curves: the gizmo binds to them automatically and its handles move, rotate or scale them."/>
                        <Button Grid.Column="1" Content="Gizmo… (G)" Click="OnGizmoPanel" HorizontalAlignment="Stretch" ToolTip.Tip="Open the gizmo panel for the finer work: orientation, unbinding, planes."/>
                    </Grid>
                    <TextBlock Text="{Binding SketchSpaceStatus}" Classes="faint" TextWrapping="Wrap" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander Header="Snapping" IsVisible="{Binding Sketch3DEnabled}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <StackPanel Spacing="6" Margin="12,0">
                <CheckBox Content="Snap to other sketches and curves" IsChecked="{Binding SketchSnapOtherCurves, Mode=TwoWay}"/>
                <CheckBox Content="Project off-plane curve snaps" IsChecked="{Binding SketchProjectOtherCurves, Mode=TwoWay}" IsEnabled="{Binding SketchSnapOtherCurves}"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
