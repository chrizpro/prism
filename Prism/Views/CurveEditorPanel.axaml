<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Prism.Controls" x:Class="Prism.Views.CurveEditorPanel">
    <UserControl.Styles><StyleInclude Source="avares://Prism/Styles/Studio.axaml"/></UserControl.Styles>
    <DockPanel Background="{DynamicResource PanelBg}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12">
            <TextBlock Text="Curve Editor" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
            <Button Grid.Column="1" Content="×" Classes="studioLink" Click="OnClose" ToolTip.Tip="Close curve editor"/>
        </Grid>
        <ScrollViewer>
            <StackPanel Margin="14" Spacing="10">
                <TextBlock Text="Select a key, choose Custom curve, and click Open Curve Editor to edit its timing." TextWrapping="Wrap" Foreground="{DynamicResource InkSoft}" IsVisible="{Binding CurveEditor, Converter={x:Static ObjectConverters.IsNull}}"/>
                <Border IsVisible="{Binding CurveEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel DataContext="{Binding CurveEditor}">
                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <c:TimingCurveEditor DataContext="{Binding Curve}"/>
                        <Button Content="Apply curve" Classes="studioAction primary" Click="OnApply" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
